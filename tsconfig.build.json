{
  "compilerOptions": {
    "lib": ["es2021", "dom"],
    "target": "es2021",
    "module": "CommonJS",
    "declaration": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "noUnusedLocals": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "exclude": [
    "dist",
    "test",
    "jest.config.ts",
    "tapplet.manifest.json",
    "node_modules"
  ],
  "include": ["./src/**/*"]
}
